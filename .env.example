# Sao chép file này thành ".env" (bỏ chữ .example) rồi điền giá trị thật.
# KHÔNG đưa file ".env" thật lên GitHub — chỉ đưa .env.example.

# Chuỗi kết nối MySQL: mysql+pymysql://<user>:<mat_khau>@<host>:3306/<ten_database>
DATABASE_URL=mysql+pymysql://root:matkhau_cua_ban@localhost:3306/bon_chan_ve_nha

# Chuỗi bí mật dùng để ký JWT — đổi thành 1 chuỗi ngẫu nhiên dài, không dùng
# đúng giá trị mẫu này khi nộp bài / triển khai thật.
JWT_SECRET_KEY=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-that-dai-va-kho-doan
JWT_ALGORITHM=HS256
JWT_HET_HAN_PHUT=1440

# Danh sách domain frontend được phép gọi API (CORS), cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:5173
